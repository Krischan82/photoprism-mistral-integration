# --- PhotoPrism ---------------------------------------------------------
# LAN IP/hostname + port of your PhotoPrism instance (adjust to your network).
PHOTOPRISM_URL=http://192.168.1.50:2342

# Recommended: create an OAuth client under Settings > Applications in
# PhotoPrism (scopes: photos, metadata, download).
PHOTOPRISM_CLIENT_ID=
PHOTOPRISM_CLIENT_SECRET=

# Fallback if you don't want to use an OAuth client:
# PHOTOPRISM_USERNAME=admin
# PHOTOPRISM_PASSWORD=

# --- Mistral AI ----------------------------------------------------------
MISTRAL_API_KEY=
# mistral-small-latest (cheaper) or mistral-large-latest (higher quality) -
# both are vision-capable aliases that always point at the current model.
MISTRAL_MODEL=mistral-small-latest

# Language for generated descriptions/keywords, e.g. English, German, French.
OUTPUT_LANGUAGE=German

# --- Feature toggles -------------------------------------------------------
ENABLE_DESCRIPTION=true
ENABLE_KEYWORDS=true
ENABLE_GEOLOCATION=true

# Only fill in missing fields by default. Set to true to have Mistral
# re-generate description/keywords/location even if already present.
OVERWRITE_EXISTING=false

# --- Run behaviour ---------------------------------------------------------
BATCH_SIZE=100
# 0 = no limit
MAX_PHOTOS_PER_RUN=0
SYNC_INTERVAL_SECONDS=3600
DRY_RUN=false
LOG_LEVEL=INFO

GEOCODE_USER_AGENT=photoprism-mistral-integration/1.0 (you@example.com)

# Photos are downscaled (longest side, in pixels) and re-encoded as JPEG
# before being sent to Mistral, to save on vision-model tokens.
IMAGE_MAX_DIMENSION=1024
IMAGE_JPEG_QUALITY=85

# --- Logging ---------------------------------------------------------------
# Host-side directory that gets bind-mounted to /app/logs (see docker-compose.yml).
# In a docker/compose/<stack>/logs layout, point this at docker/logs/photoprism-mistral.
LOG_DIR=../../logs/photoprism-mistral
